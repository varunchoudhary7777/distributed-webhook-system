APP_NAME=DistributedWebhookSystem
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:varun6107@localhost:5432/webhookdb

REDIS_URL=redis://localhost:6379/0

RABBITMQ_URL=amqp://webhook_user:webhook_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

API_KEY_PEPPER=change-this-to-another-long-random-secret

WEBHOOK_ENCRYPTION_KEY=change-this-to-long-random-secret

WEBHOOK_TIMEOUT_SECONDS=10

MAX_RETRY_ATTEMPTS=5

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.test
PUBLIC_APP_URL=http://localhost:3000

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
VERIFICATION_TOKEN_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=30