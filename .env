APP_NAME=DistributedWebhookSystem
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:varun6107@localhost:5432/webhook_db

REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=amqp://webhook_user:webhook_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

API_KEY_PEPPER=change-this-to-another-long-random-secret

WEBHOOK_ENCRYPTION_KEY=change-this-to-long-random-secret

WEBHOOK_TIMEOUT_SECONDS=10

MAX_RETRY_ATTEMPTS=5

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60